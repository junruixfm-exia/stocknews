# 股票资讯抓取网站 - 配置
# 复制此文件为 .env 并填入你的密钥

# === 免费数据源（无需任何配置即可使用）===
# 财联社、华尔街见闻、东方财富、新浪财经、雪球、金十数据 均为公开数据

# === 可选：Yahoo Finance API（免费，需要注册获取）===
# 注册地址: https://www.yahoofinanceapi.com/
YAHOO_FINANCE_API_KEY=

# === 可选：Finnhub API（免费额度 60次/分钟）===
# 注册地址: https://finnhub.io/
FINNHUB_API_KEY=

# === 可选：AI 摘要（DeepSeek，¥1/百万token，非常便宜）===
# 注册地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# === 服务器配置 ===
HOST=0.0.0.0
PORT=8000

# === 爬取间隔（分钟）===
CRAWL_INTERVAL_MINUTES=5

# === 数据库 ===
DATABASE_URL=sqlite:///stocknews.db
